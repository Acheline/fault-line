# Copy to .env and fill in. Only needed for LIVE mode (re-running the fork pipelines); the demo runs offline.
# Archive-capable Ethereum mainnet RPC (an Alchemy free-tier key works; responses are cached in data/cache/)
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
# Etherscan API key (contract names, verified sources, logs)
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY
# Local anvil fork started from ETH_RPC_URL (default below)
ANVIL_URL=http://127.0.0.1:8545
